# ~/.config/woowtechbot/woowtechbot.env: created by scripts/install.sh (mode 0600) and passed to
# the container through EnvironmentFile= (no '-' prefix: the file must exist).
#
# Rules: KEY=VALUE, no quotes, no inline "# comments" after a value. After editing, run
# scripts/install.sh again. Credentials are never set here; they are podman secrets, set with
# scripts/secret.sh (see README):
#   woowtechbot-signin-relay-token            the company sign-in mail relay token
#   woowtechbot-signin-access-client-secret   its Cloudflare Access client secret (optional)
#   woowtechbot-apporo-odoo-mcp-url           Apporo Odoo read-only MCP private URL (optional)
#   woowtechbot-woow-prod-odoo-mcp-url        woow_prod Odoo read-only MCP private URL (optional)
#   woowtechbot-android-push-credential       this installation's dedicated push relay credential
#
# The WTB_* settings are the HA add-on options under the same meaning (public_url, published_url,
# first_admin_email, ...). The container's entry point checks them like the HA Supervisor does.

# The address phones and other browsers use: an exact origin such as https://bot.example.com (no
# path). HTTPS turns on Published Apps. Plain http:// only for a trusted LAN or VPN. Empty = this
# host only (browser pairing works, phone pairing does not).
WTB_PUBLIC_URL=
# Optional second HTTPS origin for published apps, on its own DNS name (not a subdomain of the
# bot's name), e.g. https://bot-apps.example.com. Needs an HTTPS WTB_PUBLIC_URL.
WTB_PUBLISHED_URL=
# Optional: the label of this server in the phone and desktop apps (PaaS: bot.serverName). Set it
# when you also use a PaaS or HA woowtechbot, so the connections can be told apart.
WTB_SERVER_NAME=
# Optional: the first administrator's email, applied once while there is no administrator.
WTB_FIRST_ADMIN_EMAIL=
# Optional company sign-in mail relay: https://<host>/api/woowtechbot/signin-mail. Its token is
# the podman secret woowtechbot-signin-relay-token. Without both, people sign in by pairing only.
WTB_SIGNIN_RELAY_URL=
# Optional Cloudflare Access service-auth client id for that relay (the secret goes in the podman
# secret woowtechbot-signin-access-client-secret). Set both or neither.
WTB_SIGNIN_ACCESS_CLIENT_ID=
# Output-token ceiling for OpenAI-compatible models (1..1000000), as in the HA add-on.
WTB_LLM_GW_MAX_TOKENS=32000
# Optional request-normalising gateway inside the container; when on, choose
# http://127.0.0.1:8092/v1 in the app's model settings. Upstream: an origin, no key in the URL.
WTB_LLM_GW_ENABLED=false
WTB_LLM_GW_UPSTREAM=
# Android FCM relay for offline notifications. Keep this off until the Podman-specific secret is
# installed and the native app is ready. The URL is public configuration; the credential is a
# root-only podman secret, never an environment variable.
WTB_ANDROID_PUSH_ENABLED=false
WTB_ANDROID_PUSH_RELAY_URL=
# Bot turns that may run at once (OMB_TURNS_MAX_RUNNING): a number 1..64, or auto. 3 suits a
# 4-core host with WOOW_WTB_MEMORY=4g; PaaS uses 5 at 8 GiB.
WTB_TURNS_MAX_RUNNING=3
TZ=Asia/Taipei

# --- installer knobs (read by scripts/install.sh, rendered into the unit) ---
# 127.0.0.1 (default; a Cloudflare tunnel on this host reaches it), an IPv4 address of this host,
# or "all" (every address). Port 8099 (HA Ingress) and the app's owner port are never published.
WOOW_WTB_BIND=127.0.0.1
# The app and pairing entrance (container port 8080; the HA add-on maps it to 18799 too).
WOOW_WTB_PORT=18799
# The read-only published-apps site (container port 8081); published only with WTB_PUBLISHED_URL.
WOOW_WTB_PUBLISHED_PORT=18781
# Hard limits (podman --memory/--memory-swap, --cpus, --pids-limit). The app sizes its own queue
# from them. Use 3g and 2 when the host has less than 5 GB free.
WOOW_WTB_MEMORY=4g
WOOW_WTB_CPUS=2
WOOW_WTB_PIDS_LIMIT=4096
