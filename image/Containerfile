# image/Containerfile: the Podman edition = the HA add-on image, unchanged, plus this repo's entry
# point, pairing command and health check under /opt/woowtechbot-podman, and the woowtech bot icons
# of the PaaS edition in its web app. scripts/install.sh builds it on the host as
# localhost/woowtechbot-podman:<VERSION>; the base is pinned by digest in scripts/common.sh
# (WTB_BASE_IMAGE).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG WTB_VERSION
ARG BASE_IMAGE
COPY rootfs/opt/woowtechbot-podman/ /opt/woowtechbot-podman/
# The woowtech bot icons over the MausBot ones, byte for byte the PaaS edition's (brand/README.md).
COPY --chown=maus:maus --chmod=0644 brand/app-icon.svg brand/app-icon-192.png brand/app-icon-512.png brand/apple-touch-icon.png /app/dist/
# Fail the build, not the first start, when a future base no longer has what entry.cjs and brand.cjs
# rely on.
RUN test -n "$WTB_VERSION" && chmod 0755 /opt/woowtechbot-podman && chmod 0644 /opt/woowtechbot-podman/*.cjs && \
    node --check /opt/woowtechbot-podman/entry.cjs && node --check /opt/woowtechbot-podman/pair.cjs && \
    node --check /opt/woowtechbot-podman/healthcheck.cjs && node /opt/woowtechbot-podman/entry.cjs --self-test && \
    node /opt/woowtechbot-podman/brand.cjs /app/dist
LABEL io.woowtech.app="woowtechbot" org.opencontainers.image.version="${WTB_VERSION}" \
      io.woowtech.base-image="${BASE_IMAGE}" \
      org.opencontainers.image.source="https://github.com/WOOWTECH/Woow_podman_woowtechbot"
CMD ["node", "/opt/woowtechbot-podman/entry.cjs"]
